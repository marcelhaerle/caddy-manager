# Database file path
DATABASE_URL=./data/caddy-manager.db

# JWT Session Secret (minimum 32 characters in production)
JWT_SECRET=dev-super-secret-jwt-key-change-in-production-32chars

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of Caddy instance credentials
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional initial admin bootstrap credentials (can also be created via first-run UI)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@local.dev
# ADMIN_PASSWORD=changeme123
